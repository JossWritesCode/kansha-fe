# Copy to .env.local for local development. On Railway, set these as service
# variables. They're baked in at build time, so redeploy after changing them.

# URL of the Kansha API (no trailing slash)
REACT_APP_BASE_URL=http://localhost:8000

# Auth0 Single Page Application settings
REACT_APP_AUTH_DOMAIN=YOUR_TENANT.us.auth0.com
REACT_APP_CLIENT_ID=
# Where Auth0 sends users back after login/logout (this app's URL)
REACT_APP_REDIRECT_URI_BASE=http://localhost:3000
